{
    "chat.mcp.gallery.enabled": true,
    "chat.mcp.autostart": true,
    "github.copilot.chat.agent.enabled": true,
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.useCMakePresets": "always",
    "cmake.configurePreset": "default",
    "cmake.buildPreset": "default",
    "cmake.testPreset": "default",
    "cmake.cmakePath": "C:/Program Files/CMake/bin/cmake.exe",
    "cmake.useVsDeveloperEnvironment": "always",
    "cmake.configureOnOpen": true,
    "cmake.ctestArgs": [
        "-C",
        "Release",
        "--output-on-failure"
    ],

    "terminal.integrated.cwd": "${workspaceFolder}",
    "terminal.integrated.inheritEnv": true,
    "terminal.integrated.scrollback": 100000,
    "terminal.integrated.persistentSessionScrollback": 20000,
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.automationProfile.windows": {
        "path": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": [
            "-NoLogo",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass"
        ]
    },
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "path": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass"
            ]
        },
        "Command Prompt": {
            "path": "${env:SystemRoot}\\System32\\cmd.exe"
        }
    },
    "terminal.integrated.env.windows": {
        "CTEST_OUTPUT_ON_FAILURE": "1",
        "CMAKE_BUILD_PARALLEL_LEVEL": "8",
        "Path": "${env:SystemRoot}\\System32;${env:SystemRoot};${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0;C:\\Program Files\\Git\\cmd;C:\\Program Files\\CMake\\bin;C:\\Program Files (x86)\\Microsoft Visual Studio\\18\\BuildTools\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\Ninja;C:\\Program Files (x86)\\Microsoft Visual Studio\\18\\BuildTools\\VC\\Tools\\MSVC\\14.50.35717\\bin\\Hostx64\\x64;C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.0.26100.0\\x64;${env:Path};${env:PATH}"
    },

    "files.associations": {
